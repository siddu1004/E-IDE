{
  "name": "e-ide",
  "displayName": "E-IDE: Electrical Engineering Workspace",
  "description": "Visual editors for LTspice, KiCad, and Simulink files, with live agent edits.",
  "version": "0.0.1",
  "publisher": "siddu1004",
  "icon": "media/icon.png",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/siddu1004/E-IDE.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "eide.ltspiceSchematic",
        "displayName": "LTspice Schematic",
        "selector": [
          {
            "filenamePattern": "*.asc"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "eide.kicadSchematic",
        "displayName": "KiCad Schematic",
        "selector": [
          {
            "filenamePattern": "*.kicad_sch"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "eide.simulinkModel",
        "displayName": "Simulink Model",
        "selector": [
          {
            "filenamePattern": "*.slx"
          }
        ],
        "priority": "default"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "eide-apps-container",
          "title": "EEE Apps",
          "icon": "media/apps.svg"
        }
      ]
    },
    "views": {
      "eide-apps-container": [
        {
          "id": "eide.appsView",
          "name": "EEE Apps"
        }
      ]
    },
    "commands": [
      {
        "command": "eide.openAsText",
        "title": "E-IDE: Reopen as Text"
      },
      {
        "command": "eide.runSimulation",
        "title": "E-IDE: Run Simulation"
      },
      {
        "command": "eide.runKicadErc",
        "title": "E-IDE: Run ERC"
      },
      {
        "command": "eide.simulateKicad",
        "title": "E-IDE: Simulate in LTspice"
      },
      {
        "command": "eide.exportNetlist",
        "title": "E-IDE: Export Netlist"
      },
      {
        "command": "eide.runMatlabScript",
        "title": "E-IDE: Run MATLAB Script"
      },
      {
        "command": "eide.simulateSimulink",
        "title": "E-IDE: Simulate Simulink Model"
      },
      {
        "command": "eide.toggleMatlabBridge",
        "title": "E-IDE: Toggle MATLAB Session"
      },
      {
        "command": "eide.copyMcpConfig",
        "title": "E-IDE: Copy MCP config"
      },
      {
        "command": "eide.undoAgentChange",
        "title": "E-IDE: Undo Agent Change"
      },
      {
        "command": "eide.arduino.verify",
        "title": "E-IDE: Arduino Verify",
        "icon": "$(check)"
      },
      {
        "command": "eide.arduino.upload",
        "title": "E-IDE: Arduino Upload",
        "icon": "$(arrow-right)"
      },
      {
        "command": "eide.arduino.selectBoard",
        "title": "E-IDE: Arduino Select Board",
        "icon": "$(circuit-board)"
      },
      {
        "command": "eide.arduino.selectPort",
        "title": "E-IDE: Arduino Select Port",
        "icon": "$(plug)"
      },
      {
        "command": "eide.arduino.openSerial",
        "title": "E-IDE: Open Arduino Serial Monitor & Plotter",
        "icon": "$(terminal)"
      },
      {
        "command": "eide.arduino.installCli",
        "title": "E-IDE: Install arduino-cli"
      },
      {
        "command": "eide.apps.open",
        "title": "E-IDE: Open Desktop App Inside IDE (MATLAB, KiCad, LTspice, Arduino IDE)",
        "icon": "$(window)"
      },
      {
        "command": "eide.apps.openFile",
        "title": "E-IDE: Open in Desktop App Inside IDE",
        "icon": "$(window)"
      },
      {
        "command": "eide.apps.refresh",
        "title": "E-IDE: Refresh EEE Apps",
        "icon": "$(refresh)"
      },
      {
        "command": "eide.apps.installApp",
        "title": "E-IDE: Install Desktop App",
        "icon": "$(cloud-download)"
      },
      {
        "command": "eide.apps.focusWindow",
        "title": "E-IDE: Focus Desktop App Window",
        "icon": "$(window)"
      },
      {
        "command": "eide.apps.popOut",
        "title": "E-IDE: Pop Out Desktop App to Real Window",
        "icon": "$(link-external)"
      },
      {
        "command": "eide.apps.checkStatus",
        "title": "E-IDE: Check Installed EEE Apps",
        "icon": "$(check-all)"
      },
      {
        "command": "eide.apps.configurePaths",
        "title": "E-IDE: Set Custom App Paths",
        "icon": "$(settings-gear)"
      },
      {
        "command": "eide.apps.confirmReload",
        "title": "E-IDE: Confirm Reload in Desktop App",
        "icon": "$(refresh)"
      }
    ],
    "walkthroughs": [
      {
        "id": "eide.gettingStarted",
        "title": "Get started with E-IDE",
        "description": "Work with MATLAB/Simulink, KiCad, LTspice, and Arduino IDE live inside E-IDE tabs, driven by AI agents.",
        "steps": [
          {
            "id": "checkApps",
            "title": "1. Check apps",
            "description": "Check which of MATLAB, KiCad, LTspice, and Arduino IDE are installed on your machine, with direct links to install any missing tools.\n\n[Check Installed Apps](command:eide.apps.checkStatus)\n\nOfficial downloads: [MATLAB](https://www.mathworks.com/downloads/) · [KiCad](https://www.kicad.org/download/windows/) · [LTspice](https://www.analog.com/en/resources/design-tools-and-calculators/ltspice-simulator.html) · [Arduino IDE](https://www.arduino.cc/en/software)",
            "media": {
              "svg": "media/walkthrough/step1-apps.svg",
              "altText": "EEE Apps sidebar showing installed and running desktop apps"
            },
            "completionEvents": [
              "onCommand:eide.apps.checkStatus",
              "onCommand:eide.apps.refresh",
              "onView:eide.appsView"
            ]
          },
          {
            "id": "openSample",
            "title": "2. Open a sample model inside the IDE",
            "description": "Open a Simulink model (.slx), MATLAB script (.m), KiCad schematic/PCB (.kicad_sch, .kicad_pcb), LTspice circuit (.asc), or Arduino sketch (.ino) live inside an E-IDE editor tab.\n\n[Open Desktop App Inside IDE](command:eide.apps.open)",
            "media": {
              "svg": "media/walkthrough/step2-sample.svg",
              "altText": "Desktop EEE model open live inside an E-IDE tab"
            },
            "completionEvents": [
              "onCommand:eide.apps.open",
              "onCommand:eide.apps.openFile"
            ]
          },
          {
            "id": "agentDrive",
            "title": "3. Let the agent drive an app",
            "description": "E-IDE automatically registers its MCP server so your AI agent can inspect live desktop windows, click controls, type commands, edit files, and reload them in place.\n\n[Copy MCP Config](command:eide.copyMcpConfig)",
            "media": {
              "svg": "media/walkthrough/step3-agent.svg",
              "altText": "AI agent driving desktop EEE apps through E-IDE MCP tools"
            },
            "completionEvents": [
              "onCommand:eide.copyMcpConfig"
            ]
          },
          {
            "id": "customPaths",
            "title": "4. Set custom app paths",
            "description": "If MATLAB, KiCad, LTspice, or Arduino IDE is installed in a custom location, point E-IDE to its executable path in Settings.\n\n[Set Custom App Paths](command:eide.apps.configurePaths)",
            "media": {
              "svg": "media/walkthrough/step4-paths.svg",
              "altText": "Custom executable path settings for E-IDE apps"
            },
            "completionEvents": [
              "onCommand:eide.apps.configurePaths",
              "onSettingChanged:eide.apps.matlabPath",
              "onSettingChanged:eide.apps.kicadPath",
              "onSettingChanged:eide.apps.ltspicePath",
              "onSettingChanged:eide.apps.arduinoPath"
            ]
          }
        ]
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "eide.arduino.verify",
          "when": "resourceExtname == .ino",
          "group": "navigation@1"
        },
        {
          "command": "eide.arduino.upload",
          "when": "resourceExtname == .ino",
          "group": "navigation@2"
        },
        {
          "command": "eide.arduino.selectBoard",
          "when": "resourceExtname == .ino",
          "group": "navigation@3"
        },
        {
          "command": "eide.arduino.selectPort",
          "when": "resourceExtname == .ino",
          "group": "navigation@4"
        },
        {
          "command": "eide.arduino.openSerial",
          "when": "resourceExtname == .ino",
          "group": "navigation@5"
        },
        {
          "command": "eide.apps.openFile",
          "when": "resourceExtname =~ /^\\.(slx|mdl|m|mlx|kicad_sch|kicad_pcb|asc|ino)$/",
          "group": "navigation@9"
        }
      ],
      "explorer/context": [
        {
          "command": "eide.apps.openFile",
          "when": "resourceExtname =~ /^\\.(slx|mdl|m|mlx|kicad_pro|kicad_sch|kicad_pcb|asc|ino)$/",
          "group": "navigation@9"
        }
      ],
      "view/title": [
        {
          "command": "eide.apps.refresh",
          "when": "view == eide.appsView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "eide.apps.open",
          "when": "view == eide.appsView && (viewItem == installedApp || viewItem == runningApp)",
          "group": "inline"
        },
        {
          "command": "eide.apps.installApp",
          "when": "view == eide.appsView && viewItem == uninstalledApp",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "E-IDE",
      "properties": {
        "eide.agent.autoRegister": {
          "type": "boolean",
          "default": true,
          "description": "Add this session's E-IDE server to Antigravity's mcp_config.json on startup and remove it on exit, so the agent can use E-IDE without copying the config by hand."
        },
        "eide.agent.requireApproval": {
          "type": "boolean",
          "default": false,
          "description": "Require user confirmation before applying AI agent schematic or model modifications."
        },
        "eide.ltspice.path": {
          "type": "string",
          "default": "",
          "description": "Path to the LTspice executable. If empty, default installation paths are searched."
        },
        "eide.ltspice.autoRun": {
          "type": "boolean",
          "default": true,
          "description": "Automatically re-run simulation when the schematic changes (debounced 800ms)."
        },
        "eide.ltspice.timeout": {
          "type": "number",
          "default": 60,
          "description": "Timeout in seconds for LTspice batch simulation."
        },
        "eide.kicad.cliPath": {
          "type": "string",
          "default": "",
          "description": "Path to the kicad-cli executable. If empty, default installation paths are searched."
        },
        "eide.kicad.autoSimulate": {
          "type": "boolean",
          "default": false,
          "description": "Automatically re-run simulation when the KiCad schematic changes."
        },
        "eide.matlab.path": {
          "type": "string",
          "default": "",
          "description": "Path to the MATLAB executable. If empty, default installation paths are searched."
        },
        "eide.simulink.autoSimulate": {
          "type": "boolean",
          "default": false,
          "description": "Automatically re-run simulation when the Simulink model changes."
        },
        "eide.arduino.cliPath": {
          "type": "string",
          "default": "",
          "description": "Path to the arduino-cli executable. If empty, default installation paths are searched."
        },
        "eide.arduino.selectedBoard": {
          "type": "string",
          "default": "arduino:avr:uno",
          "description": "Currently selected Arduino board FQBN."
        },
        "eide.arduino.selectedPort": {
          "type": "string",
          "default": "",
          "description": "Currently selected serial port for Arduino upload and serial monitor."
        },
        "eide.apps.matlabPath": {
          "type": "string",
          "default": "",
          "description": "Path to MATLAB (matlab.exe), used when E-IDE cannot find it in the usual install folders."
        },
        "eide.apps.kicadPath": {
          "type": "string",
          "default": "",
          "description": "Path to KiCad (kicad.exe), used when E-IDE cannot find it in the usual install folders."
        },
        "eide.apps.ltspicePath": {
          "type": "string",
          "default": "",
          "description": "Path to LTspice (LTspice.exe), used when E-IDE cannot find it in the usual install folders."
        },
        "eide.apps.arduinoPath": {
          "type": "string",
          "default": "",
          "description": "Path to Arduino IDE (Arduino IDE.exe), used when E-IDE cannot find it in the usual install folders."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "npm run compile && node --test \"out/test/**/*.test.js\"",
    "test:integration": "npm run compile && node out/test-integration/runTest.js",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "mocha": "^12.0.3",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  }
}
