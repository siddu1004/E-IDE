{
  "name": "e-ide",
  "displayName": "E-IDE: Electrical Engineering Workspace",
  "description": "Visual editors for LTspice, KiCad, and Simulink files, with live agent edits.",
  "version": "0.0.1",
  "publisher": "siddu1004",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/siddu1004/E-IDE.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "eide.ltspiceSchematic",
        "displayName": "LTspice Schematic",
        "selector": [
          {
            "filenamePattern": "*.asc"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "eide.kicadSchematic",
        "displayName": "KiCad Schematic",
        "selector": [
          {
            "filenamePattern": "*.kicad_sch"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "eide.simulinkModel",
        "displayName": "Simulink Model",
        "selector": [
          {
            "filenamePattern": "*.slx"
          }
        ],
        "priority": "default"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "eide-apps-container",
          "title": "EEE Apps",
          "icon": "media/apps.svg"
        }
      ]
    },
    "views": {
      "eide-apps-container": [
        {
          "id": "eide.appsView",
          "name": "EEE Apps"
        }
      ]
    },
    "commands": [
      {
        "command": "eide.openAsText",
        "title": "E-IDE: Reopen as Text"
      },
      {
        "command": "eide.runSimulation",
        "title": "E-IDE: Run Simulation"
      },
      {
        "command": "eide.runKicadErc",
        "title": "E-IDE: Run ERC"
      },
      {
        "command": "eide.simulateKicad",
        "title": "E-IDE: Simulate in LTspice"
      },
      {
        "command": "eide.exportNetlist",
        "title": "E-IDE: Export Netlist"
      },
      {
        "command": "eide.runMatlabScript",
        "title": "E-IDE: Run MATLAB Script"
      },
      {
        "command": "eide.simulateSimulink",
        "title": "E-IDE: Simulate Simulink Model"
      },
      {
        "command": "eide.toggleMatlabBridge",
        "title": "E-IDE: Toggle MATLAB Session"
      },
      {
        "command": "eide.copyMcpConfig",
        "title": "E-IDE: Copy MCP config"
      },
      {
        "command": "eide.undoAgentChange",
        "title": "E-IDE: Undo Agent Change"
      },
      {
        "command": "eide.arduino.verify",
        "title": "E-IDE: Arduino Verify",
        "icon": "$(check)"
      },
      {
        "command": "eide.arduino.upload",
        "title": "E-IDE: Arduino Upload",
        "icon": "$(arrow-right)"
      },
      {
        "command": "eide.arduino.selectBoard",
        "title": "E-IDE: Arduino Select Board",
        "icon": "$(circuit-board)"
      },
      {
        "command": "eide.arduino.selectPort",
        "title": "E-IDE: Arduino Select Port",
        "icon": "$(plug)"
      },
      {
        "command": "eide.arduino.openSerial",
        "title": "E-IDE: Open Arduino Serial Monitor & Plotter",
        "icon": "$(terminal)"
      },
      {
        "command": "eide.arduino.installCli",
        "title": "E-IDE: Install arduino-cli"
      },
      {
        "command": "eide.apps.open",
        "title": "E-IDE: Open Desktop App Inside IDE (MATLAB, KiCad, LTspice, Arduino IDE)",
        "icon": "$(window)"
      },
      {
        "command": "eide.apps.openFile",
        "title": "E-IDE: Open in Desktop App Inside IDE",
        "icon": "$(window)"
      },
      {
        "command": "eide.apps.refresh",
        "title": "E-IDE: Refresh EEE Apps",
        "icon": "$(refresh)"
      },
      {
        "command": "eide.apps.installApp",
        "title": "E-IDE: Install Desktop App",
        "icon": "$(cloud-download)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "eide.arduino.verify",
          "when": "resourceExtname == .ino",
          "group": "navigation@1"
        },
        {
          "command": "eide.arduino.upload",
          "when": "resourceExtname == .ino",
          "group": "navigation@2"
        },
        {
          "command": "eide.arduino.selectBoard",
          "when": "resourceExtname == .ino",
          "group": "navigation@3"
        },
        {
          "command": "eide.arduino.selectPort",
          "when": "resourceExtname == .ino",
          "group": "navigation@4"
        },
        {
          "command": "eide.arduino.openSerial",
          "when": "resourceExtname == .ino",
          "group": "navigation@5"
        },
        {
          "command": "eide.apps.openFile",
          "when": "resourceExtname =~ /^\\.(slx|mdl|kicad_sch|kicad_pcb|asc)$/",
          "group": "navigation@9"
        }
      ],
      "explorer/context": [
        {
          "command": "eide.apps.openFile",
          "when": "resourceExtname =~ /^\\.(slx|mdl|m|mlx|kicad_pro|kicad_sch|kicad_pcb|asc|ino)$/",
          "group": "navigation@9"
        }
      ],
      "view/title": [
        {
          "command": "eide.apps.refresh",
          "when": "view == eide.appsView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "eide.apps.open",
          "when": "view == eide.appsView && (viewItem == installedApp || viewItem == runningApp)",
          "group": "inline"
        },
        {
          "command": "eide.apps.installApp",
          "when": "view == eide.appsView && viewItem == uninstalledApp",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "E-IDE",
      "properties": {
        "eide.agent.autoRegister": {
          "type": "boolean",
          "default": true,
          "description": "Add this session's E-IDE server to Antigravity's mcp_config.json on startup and remove it on exit, so the agent can use E-IDE without copying the config by hand."
        },
        "eide.agent.requireApproval": {
          "type": "boolean",
          "default": false,
          "description": "Require user confirmation before applying AI agent schematic or model modifications."
        },
        "eide.ltspice.path": {
          "type": "string",
          "default": "",
          "description": "Path to the LTspice executable. If empty, default installation paths are searched."
        },
        "eide.ltspice.autoRun": {
          "type": "boolean",
          "default": true,
          "description": "Automatically re-run simulation when the schematic changes (debounced 800ms)."
        },
        "eide.ltspice.timeout": {
          "type": "number",
          "default": 60,
          "description": "Timeout in seconds for LTspice batch simulation."
        },
        "eide.kicad.cliPath": {
          "type": "string",
          "default": "",
          "description": "Path to the kicad-cli executable. If empty, default installation paths are searched."
        },
        "eide.kicad.autoSimulate": {
          "type": "boolean",
          "default": false,
          "description": "Automatically re-run simulation when the KiCad schematic changes."
        },
        "eide.matlab.path": {
          "type": "string",
          "default": "",
          "description": "Path to the MATLAB executable. If empty, default installation paths are searched."
        },
        "eide.simulink.autoSimulate": {
          "type": "boolean",
          "default": false,
          "description": "Automatically re-run simulation when the Simulink model changes."
        },
        "eide.arduino.cliPath": {
          "type": "string",
          "default": "",
          "description": "Path to the arduino-cli executable. If empty, default installation paths are searched."
        },
        "eide.arduino.selectedBoard": {
          "type": "string",
          "default": "arduino:avr:uno",
          "description": "Currently selected Arduino board FQBN."
        },
        "eide.arduino.selectedPort": {
          "type": "string",
          "default": "",
          "description": "Currently selected serial port for Arduino upload and serial monitor."
        },
        "eide.apps.matlabPath": {
          "type": "string",
          "default": "",
          "description": "Path to MATLAB (matlab.exe), used when E-IDE cannot find it in the usual install folders."
        },
        "eide.apps.kicadPath": {
          "type": "string",
          "default": "",
          "description": "Path to KiCad (kicad.exe), used when E-IDE cannot find it in the usual install folders."
        },
        "eide.apps.ltspicePath": {
          "type": "string",
          "default": "",
          "description": "Path to LTspice (LTspice.exe), used when E-IDE cannot find it in the usual install folders."
        },
        "eide.apps.arduinoPath": {
          "type": "string",
          "default": "",
          "description": "Path to Arduino IDE (Arduino IDE.exe), used when E-IDE cannot find it in the usual install folders."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "npm run compile && node --test \"out/test/**/*.test.js\"",
    "test:integration": "npm run compile && node out/test-integration/runTest.js",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "mocha": "^12.0.3",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  }
}
